# Copy to .env in project root; generate a local secret using secrets.token_hex(32).
SECRET_KEY=
# Default DB: <project>/instance/dermascan.db. Optional override:
# DATABASE_URL=sqlite:////absolute/path/to/instance/dermascan.db
SESSION_COOKIE_SECURE=false
# Optional paths used by the training/legacy AI scripts. Leave empty to use project-relative defaults.
# SKIN_CANCER_BASE=
# ISIC_DATA_DIR=
# Only enable for local fictional demo data. Never use real passwords here.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
# SMTP configuration for Flask-Mail. Keep credentials only in local .env.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=DermaScan AI <no-reply@example.com>
MAIL_TIMEOUT=10
